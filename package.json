{
  "name": "curapro",
  "version": "1.0.0",
  "description": "CuraPro — Asistente de Curación Avanzada",
  "main": "electron/main.js",
  "author": "CuraPro",
  "license": "UNLICENSED",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "cap:sync": "npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "6.2.0",
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "cl.curapro.app",
    "productName": "CuraPro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "CuraPro-Instalador.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CuraPro"
    }
  }
}
